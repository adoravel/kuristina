{
	"workspace": [
		"./apps/*",
		"./packages/commands",
		"./packages/config",
		"./packages/core",
		"./packages/database",
		"./packages/errors",
		"./packages/services",
		"./packages/i18n",
		"./packages/platform/discord/*"
	],
	"tasks": {
		"check": "deno check apps/bot/main.ts",
		"dev": "deno run --watch -P=default apps/bot/main.ts",
		"start": "deno run -P=default apps/bot/main.ts",
		"lint": "deno lint",
		"test": "deno test --allow-env --allow-read",
		"add-header": "deno fmt && deno run --allow-read --allow-write scripts/copyright.ts"
	},
	"permissions": {
		"default": {
			"read": true,
			"write": true,
			"env": true,
			"net": true,
			"ffi": true,
			"run": true,
			"sys": true
		}
	},
	"imports": {
		"scripts/": "./scripts/"
	},
	"lint": {
		"rules": {
			"exclude": ["no-explicit-any", "no-slow-types", "jsx-key", "jsx-button-has-type"]
		}
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@kuristina/discord-ui"
	},
	"fmt": {
		"useTabs": true,
		"semiColons": true,
		"lineWidth": 100
	}
}
